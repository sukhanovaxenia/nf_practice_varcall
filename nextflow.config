params.reads        = '${projectDir}/data/*_R{1,2}.fastq.gz'
params.reference    = '${projectDir}/data/MT.fna'
// conda.enabled       = true
// conda.useMamba      = true // for mamba both configs are needed: conda + mamba = True
// docker.enabled    = true
// apptainer.enabled = true
// singularity.enabled = true
// wave.enabled = true
profiles {
    conda {
        conda.enabled       = true
    }
    mamba {
        conda.enabled       = true
        conda.useMamba      = true
    }
    docker {
        docker.enabled       = true
    }
    apptainer {
        apptainer.enabled       = true
    }
    singularity {
        singularity.enabled       = true
    }
} // profiles're better 'cause you can list several profiles with comma-separator